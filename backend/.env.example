# GigaChat
GIGACHAT_AUTH_KEY=your_gigachat_auth_key_here
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true

# Models
DEFAULT_MODEL=GigaChat-2-Pro
DEFAULT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRELOAD_MODELS=false

# App
DOMAIN=http://localhost:3000
FRONT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
GIGACHAT_AUTH_KEY_FILE=

# External secret manager (optional)
SECRET_MANAGER_URL=
SECRET_MANAGER_TOKEN=
SECRET_MANAGER_TIMEOUT=5

# Database
USE_DATABASE=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=converter
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Feature flags
FEATURE_RUST_SIDECAR=false
FEATURE_KANDINSKY=false
FEATURE_PROGRESS_WS=true
FEATURE_DB_TOGGLE_ADMIN=true

# Rust sidecar
RUST_SIDECAR_URL=http://rust-sidecar:7001
RUST_SIDECAR_TIMEOUT=30

# Kandinsky auto provider (internal preferred, fallback public)
KANDINSKY_INTERNAL_URL=
KANDINSKY_INTERNAL_TOKEN=
KANDINSKY_PUBLIC_URL=
KANDINSKY_PUBLIC_API_KEY=
KANDINSKY_TIMEOUT=60
